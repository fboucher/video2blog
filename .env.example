# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Skills Configuration
# Path to the folder containing skill definitions (SKILL.md files)
SKILLS_FOLDER=./skills

# Editing Service Configuration
# Provider: "anthropic" or "openai" (default: anthropic)
EDITING_PROVIDER=anthropic
# API key for the editing service
EDITING_API_KEY=your_api_key_here
# Model to use (defaults: claude-3-haiku-20240307 for Anthropic, gpt-4o-mini for OpenAI)
EDITING_MODEL=claude-3-haiku-20240307
# Optional: OpenAI-compatible base URL (e.g., for custom deployments)
EDITING_BASE_URL=
